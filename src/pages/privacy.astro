---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy" description="What business contact data Statecraft Systems keeps for outreach, why, and how to opt out.">
  <section class="wrap page-head">
    <span class="eyebrow">Privacy</span>
    <h1>What we keep when we write to you.</h1>
  </section>

  <section class="wrap split">
    <div class="left"><h2>Outreach</h2></div>
    <div class="right prose">
      <p><strong>What we keep.</strong> Your name, your published business email address and your company.</p>
      <p><strong>Where it comes from.</strong> Public websites, such as your company's own site.</p>
      <p><strong>Why.</strong> To offer business-to-business introductions, for example to buyers that license operating records.</p>
      <p><strong>Opting out.</strong> Reply "unsubscribe" to any email, or write to <a href="mailto:m@statecraft.systems">m@statecraft.systems</a>. We stop within 10 business days.</p>
      <p><strong>Selling.</strong> We do not sell or rent contact data.</p>
      <p>Statecraft Systems LLC · <a href="mailto:m@statecraft.systems">m@statecraft.systems</a></p>
    </div>
  </section>
</BaseLayout>
