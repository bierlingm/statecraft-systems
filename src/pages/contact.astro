---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
---

<BaseLayout title="Contact" description="Write to Statecraft Systems. The reply comes from the person who would build it.">
  <section class="wrap page-head">
    <span class="eyebrow">Contact</span>
    <h1>Describe what you need.</h1>
    <p class="lede">What happens now, what should happen, and who does the work today. A few sentences is enough. The reply comes from the person who would build it.</p>
    <a class="link-rule" style="font-size: 1.125rem; border-bottom-width: 2px;" href="mailto:m@statecraft.systems">m@statecraft.systems</a>
    <QuickAnswer>
      <p>Email <a href="mailto:m@statecraft.systems">m@statecraft.systems</a> with what happens now, what should happen, and who does the work today; a few sentences is enough. The reply comes from Moritz Bierling, the principal. Existing clients can find help on the <a href="/support/">support page</a>.</p>
    </QuickAnswer>
  </section>

  <section class="wrap split" style="padding-top: 0;">
    <div class="left">
      <span class="eyebrow">Who you will be writing to</span>
    </div>
    <div class="right ledger">
      <div><span class="name">Moritz Bierling</span><span class="meta">Principal</span><span class="desc"><a href="https://moritzbierling.com" rel="noopener" style="border-bottom: 1px solid var(--accent);">moritzbierling.com</a></span></div>
      <div><span class="name muted">Entity</span><span class="meta"></span><span class="desc">Statecraft Systems LLC · A US company.</span></div>
    </div>
  </section>
</BaseLayout>
