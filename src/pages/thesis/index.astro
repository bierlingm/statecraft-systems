---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { disciplines } from '../../data/disciplines';

// The thesis: ten propositions.
// It names no project or programme, so it does not date when those change.
// This page is about the ideas. What is sold is on the home, work and method pages.
const theses: { n: string; title: string; body: string[] }[] = [
  { n: 'I', title: 'Something always rules.', body: [
    'Every household, company and country is run by someone or something. It may be one person’s memory, a vendor’s terms of service, or an arrangement people designed on purpose. So the question is how well it is run.',
    'The need for good rule never runs out. Every civilisation that built something lasting had it.',
  ] },
  { n: 'II', title: 'Good rule is scarce.', body: [
    'Ruling well takes judgment, responsibility and care. It needs people who see what is in front of them, act on it, and accept the obligations that come with power.',
    'Few people start out able to do this, and administration cannot stand in for it.',
  ] },
  { n: 'III', title: 'It does not maintain itself.', body: [
    'A prohibition has to be enforced by someone. A principle lasts only as long as some structure carries it.',
    'When nobody passes these on, procedure takes the place of authority, and obligations start to run in one direction.',
  ] },
  { n: 'IV', title: 'Structure is what lasts.', body: [
    'People leave. What they built into a structure keeps working after them, holds up under pressure, and teaches the next people how it is done.',
    'We build structures of that kind.',
  ] },
  { n: 'V', title: 'Look before building.', body: [
    'Before any work starts we find out what is going on now: what is true, what each side owes the other, and what people will in fact do.',
  ] },
  { n: 'VI', title: 'A structure advances or oscillates.', body: [
    'If action is driven by a problem, it stops when the problem eases, and then the problem returns. If it is driven by the difference between how things are and how you want them, it continues until the two match.',
    'Which of these you get depends on the structure. Motivation has little to do with it.',
  ] },
  { n: 'VII', title: 'Reciprocity holds it together.', body: [
    'Reputation, credit, obligation and trust all move between people, and good rule depends on how they move.',
    'An arrangement lasts when duties run in both directions. We do not work with people who only want to take.',
  ] },
  { n: 'VIII', title: 'Conditions have changed.', body: [
    'Institutions built for the twentieth century are struggling with the present, and AI is reorganising most kinds of work.',
    'You can use these tools to make what you want, or you can use products that someone else controls. The difference is who decides.',
  ] },
  { n: 'IX', title: 'Sovereignty has to be built.', body: [
    'Sovereignty means deciding for yourself by means you control. In practice that is systems you own, people you share obligations with, and the ability to understand what is happening and act on it quickly.',
  ] },
  { n: 'X', title: 'A tradition is a structure that teaches.', body: [
    'A tradition is alive while people practise it and understand what it is for. It lasts when the people doing the work can teach it to others.',
    'Ours is young.',
  ] },
];
// Each discipline names the propositions that rest on it; the link is shown here from the other side.
const drawsOn = (n: string) => disciplines.filter((d) => d.thesis.some((t) => t.n === n));
---

<BaseLayout title="Thesis" description="Ten propositions on good rule. It is scarce, it does not maintain itself, and it lasts only where a structure carries it.">
  <section class="wrap page-head">
    <h1>Ten propositions on good rule.</h1>
    <p class="lede">Why the practice exists.</p>
  </section>

  <ol class="wrap theses">
    {theses.map((t) => (
      <li class="reveal" id={t.n.toLowerCase()}>
        <span class="n">{t.n}</span>
        <h2>{t.title}</h2>
        {t.body.map((p) => <p>{p}</p>)}
        {drawsOn(t.n).length > 0 && (
          <p class="src">Draws on {drawsOn(t.n).map((d) => <a href={`/disciplines/${d.slug}`}>{d.name}</a>)}</p>
        )}
      </li>
    ))}
  </ol>

  <section class="wrap after-list">
    <a class="btn ghost" href="/disciplines">The four disciplines</a>
  </section>

  <ContactBlock />
</BaseLayout>
