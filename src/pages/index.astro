---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { plates } from '../data/work';
import { SITE_URL, SITE_DESCRIPTION } from '../data/site';

// The home page is the offering: what is built, for whom, the proof, how a build runs.
// The ideas behind it live on /thesis and /disciplines and get one doorway here.

// Structured data: only what this page states (header, hero, footer, meta description).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': `${SITE_URL}/#organization`,
      name: 'Statecraft Systems',
      legalName: 'Statecraft Systems LLC',
      url: `${SITE_URL}/`,
      email: 'm@statecraft.systems',
      description: SITE_DESCRIPTION,
      image: `${SITE_URL}/og-default.png`,
      founder: {
        '@type': 'Person',
        '@id': `${SITE_URL}/#moritz-bierling`,
        name: 'Moritz Bierling',
        url: 'https://moritzbierling.com',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'Statecraft Systems',
      url: `${SITE_URL}/`,
      description: SITE_DESCRIPTION,
      inLanguage: 'en',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
  ],
};
---

<BaseLayout title="Statecraft Systems" jsonLd={jsonLd} tone="field">
  <section class="hero field">
    <div class="wrap">
      <h1 aria-label="The craft of good rule.">
        <span class="rise" style="--i:0" aria-hidden="true"><span>The craft</span></span>
        <span class="rise" style="--i:1" aria-hidden="true"><span>of good rule<span class="stop">.</span></span></span>
      </h1>
      <div class="hero-foot">
        <p class="lede">We build the working parts of small institutions: intake for a clinic, booking for a house, enquiries for a supplier. Designed with the people who run the place, owned by them, and made to keep working after we step back.</p>
        <div class="hero-actions">
          <a class="btn" href="mailto:m@statecraft.systems">Write to us</a>
          <a class="link-rule" href="/work">See the work</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="ways-h">
    <h2 class="statement reveal" id="ways-h">Two ways to work.</h2>
    <ul class="scales">
      <li class="reveal"><a href="/work">
        <span class="glyph" aria-hidden="true"><svg viewBox="0 0 100 100"><rect class="b" width="100" height="100" /></svg></span>
        <h3>For an institution</h3>
        <p>A clinic, a house, a supplier, a cause. We build its working parts: how a request arrives, how a date is held, who hears about it and when. Yours, written down, made to be handed on.</p>
        <span class="go">See the work</span>
      </a></li>
      <li class="reveal"><a href="mailto:m@statecraft.systems?subject=Working%20sessions">
        <span class="glyph" aria-hidden="true"><svg viewBox="0 0 100 100"><circle class="b" cx="50" cy="50" r="50" /></svg></span>
        <h3>For a person</h3>
        <p>A founder, an executive, a team. We build real tools on your own devices and workflows, then teach you to extend them. The capability stays with you.</p>
        <span class="go">Write to us</span>
      </a></li>
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="work-h">
    <h2 class="statement reveal" id="work-h">Small, and real.</h2>
    <ol class="index">
      {plates.map((plate) => (
        <li>
          <a href={`/work/${plate.slug}`}>
            <span class="title">{plate.title}</span>
            <span class="who"><b>{plate.client}</b>{plate.principle}</span>
            <span class="status">{plate.status}</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="after"><a class="btn ghost" href="/work">All the work</a></div>
  </section>

  <section class="section ground" aria-labelledby="run-h">
    <div class="wrap">
      <h2 class="statement" id="run-h">How a build runs.</h2>
      <ol class="run">
        <li><h3>See</h3><p>One conversation with the person who does the work today.</p></li>
        <li><h3>Build</h3><p>A working version at a real address, in rounds. You leave notes on the page itself.</p></li>
        <li><h3>Launch</h3><p>Everything is written down so that someone else could carry it.</p></li>
        <li><h3>Run</h3><p>You take it over, or we keep it running and you hear only when something needs you.</p></li>
      </ol>
      <div class="after">
        <a class="btn ghost" href="/method">The method</a>
        <p class="run-note">A small site takes one to three weeks, end to end.</p>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="why-h">
    <h2 class="statement reveal" id="why-h">The thinking behind it.</h2>
    <ul class="index">
      <li><a href="/thesis">
        <span class="title">Thesis</span>
        <span class="who wide">Ten propositions on good rule, and what the name means.</span>
      </a></li>
      <li><a href="/disciplines">
        <span class="title">Disciplines</span>
        <span class="who wide">Structural dynamics, natural law, currency design, operative traditions.</span>
      </a></li>
    </ul>
  </section>

  <ContactBlock />
</BaseLayout>
