---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlateCard from '../components/PlateCard.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import { plates } from '../data/work';
import { SITE_URL, SITE_DESCRIPTION } from '../data/site';

// Structured data: only what this page states (header, hero, footer, meta description).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': `${SITE_URL}/#organization`,
      name: 'Statecraft Systems',
      legalName: 'Statecraft Systems LLC',
      url: `${SITE_URL}/`,
      email: 'm@statecraft.systems',
      description: SITE_DESCRIPTION,
      image: `${SITE_URL}/og-default.png`,
      founder: {
        '@type': 'Person',
        '@id': `${SITE_URL}/#moritz-bierling`,
        name: 'Moritz Bierling',
        url: 'https://moritzbierling.com',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'Statecraft Systems',
      url: `${SITE_URL}/`,
      description: SITE_DESCRIPTION,
      inLanguage: 'en',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
  ],
};

---

<BaseLayout title="Statecraft Systems" jsonLd={jsonLd}>
  <section class="wrap hero">
    <h1>We build the <em>working parts</em> of small institutions.</h1>
    <p class="lede">Intake for a clinic. Booking for a house. Enquiries for a supplier. Designed with the people who run the place, reviewed on the real thing, and built to keep working after we step back.</p>
    <p class="practice">The practice of <a href="https://moritzbierling.com" rel="noopener">Moritz Bierling</a> · <a href="mailto:m@statecraft.systems">m@statecraft.systems</a></p>
  </section>

  <section class="wrap plates" aria-labelledby="plates-h">
    <div class="section-head">
      <h2 id="plates-h">Recent work</h2>
      <span class="note">Clients are described, not named.</span>
    </div>
    <div class="plate-grid">
      {plates.map((plate) => <PlateCard plate={plate} />)}
    </div>
    <a class="link-rule" href="/work">All work</a>
  </section>

  <section class="wrap how" aria-labelledby="how-h">
    <div class="section-head">
      <h2 id="how-h">How a build runs</h2>
      <span class="note">A small site: one to three weeks, end to end.</span>
    </div>
    <ol class="how-steps">
      <li><span class="num">01</span><h3>See what is there</h3><p>One conversation with the person who does the work.</p></li>
      <li><span class="num">02</span><h3>Build, in rounds</h3><p>A working version at a real address. Notes land on the page they are about.</p></li>
      <li><span class="num">03</span><h3>Launch</h3><p>Written down so that someone else could carry it.</p></li>
      <li><span class="num">04</span><h3>Run it, or we do</h3><p>Take it over, or leave it with us and hear only when it matters.</p></li>
    </ol>
    <a class="link-rule" href="/method">More on the method</a>
  </section>

  <section class="contact">
    <div class="wrap">
      <p class="big">Describe what you need. The reply comes from the person who would build it.</p>
      <a class="link-rule" href="mailto:m@statecraft.systems">m@statecraft.systems</a>
      <QuickAnswer>
        <p>Statecraft Systems is the practice of Moritz Bierling, run as Statecraft Systems LLC, a US company. It builds the working parts of small institutions, such as intake for a clinic, booking for a house and enquiries for a supplier, designed with the people who run the place and reviewed on the real thing.</p>
      </QuickAnswer>
    </div>
  </section>
</BaseLayout>
