---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlateCard from '../components/PlateCard.astro';
import Assembly from '../components/Assembly.astro';
import DetailA from '../components/DetailA.astro';
import ThesisBand from '../components/ThesisBand.astro';
import ContactBlock from '../components/ContactBlock.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import { plates } from '../data/work';
import { SITE_URL, SITE_DESCRIPTION } from '../data/site';

// Structured data: only what this page states (header, hero, footer, meta description).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': `${SITE_URL}/#organization`,
      name: 'Statecraft Systems',
      legalName: 'Statecraft Systems LLC',
      url: `${SITE_URL}/`,
      email: 'm@statecraft.systems',
      description: SITE_DESCRIPTION,
      image: `${SITE_URL}/og-default.png`,
      founder: {
        '@type': 'Person',
        '@id': `${SITE_URL}/#moritz-bierling`,
        name: 'Moritz Bierling',
        url: 'https://moritzbierling.com',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'Statecraft Systems',
      url: `${SITE_URL}/`,
      description: SITE_DESCRIPTION,
      inLanguage: 'en',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
  ],
};

const [feature, ...rest] = plates;
---

<BaseLayout title="Statecraft Systems" jsonLd={jsonLd}>
  <section class="wrap hero" aria-labelledby="hero-h">
    <div class="hero-text">
      <span class="eyebrow">The practice of <a href="https://moritzbierling.com" rel="noopener">Moritz Bierling</a></span>
      <h1 id="hero-h">I build the <em>working parts</em> of small institutions.</h1>
      <p class="lede">With the people who run them, on the real thing, and made to keep working after I step back.</p>
      <div class="hero-act">
        <a class="link-rule" href="/work">See the plates</a>
        <a class="link-rule" href="mailto:m@statecraft.systems">m@statecraft.systems</a>
      </div>
    </div>
    <div class="hero-figure">
      <Assembly />
    </div>
  </section>

  <section class="wrap sheet" aria-labelledby="parts-h">
    <div class="sheet-head"><span class="no">Sheet 02</span><span class="t">What a working part is</span><span class="aside">The idea, in three paragraphs.</span></div>
    <div class="datum" aria-hidden="true"></div>
    <div class="parts-essay">
      <h3 id="parts-h">A small institution runs on what a few people carry in their heads. A working part carries some of it for them.</h3>
      <div class="prose">
        <p>How a request comes in. Which calendar is true. Who decides, and by what rule. Where the record lives. In a practice, a house, a supplier or a cause, these usually live with one or two people, and they hold for as long as those people are there.</p>
        <p>A working part takes one of them out of a head and makes it hold on its own. It is built with the people who run the place, reviewed on the real thing, and written down so that someone else could carry it.</p>
        <p>Every part on this site is small enough to keep alive without a team. That is the point of it.</p>
      </div>
    </div>
  </section>

  <section class="wrap sheet" aria-labelledby="plates-h">
    <div class="sheet-head"><span class="no">Sheet 03</span><h2 id="plates-h">Plates · recent work</h2><span class="aside">Clients are described, not named.</span></div>
    <div class="datum" aria-hidden="true"></div>
    <div class="plates">
      <PlateCard plate={feature} feature />
      <div class="plate-row">
        {rest.map((plate) => <PlateCard plate={plate} />)}
      </div>
    </div>
    <p class="also"><span class="eyebrow">Also</span> <span>Helping companies decide whether to license their operating records for AI training, safely. <a href="/operating-records">How it works</a></span></p>
  </section>

  <DetailA sheet="Sheet 04" />

  <section class="wrap sheet" aria-labelledby="instruments-h">
    <div class="sheet-head"><span class="no">Sheet 05</span><span class="t">Instruments</span><span class="aside">Used on every build before they are offered to anyone else.</span></div>
    <div class="datum" aria-hidden="true"></div>
    <div class="split">
      <div class="left">
        <h2 id="instruments-h">Tools we built for our own work, and publish.</h2>
      </div>
      <div class="right ledger">
        <a href="/instruments#spikes"><span class="name">spikes</span><span class="meta">v0.5 · open source</span><span class="desc">Comments left on the real page, handed to the building agent as precise notes. Every plate above was reviewed with it.</span></a>
        <a href="/werk"><span class="name">werk</span><span class="meta">v1.6 · Rust</span><span class="desc">Holds what you want against what is true, and keeps the gap in view until it closes. Structural dynamics, as an instrument.</span></a>
      </div>
    </div>
  </section>

  <ThesisBand />
  <ContactBlock />

  <section class="wrap brief">
    <QuickAnswer date="2026-11-11">
      <p>Statecraft Systems is the practice of Moritz Bierling, run as Statecraft Systems LLC, a US company. It builds the working parts of small institutions with the people who run them, reviewed on the real thing and made to keep working after he steps back. Recent work includes direct booking for a family-owned vacation rental and trade enquiries for a regional jobsite-supply wholesaler.</p>
      <p>To start, describe what you need to <a href="mailto:m@statecraft.systems">m@statecraft.systems</a>. The reply comes from the person who would build it.</p>
    </QuickAnswer>
  </section>
</BaseLayout>
