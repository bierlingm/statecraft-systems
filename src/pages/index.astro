---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { plates } from '../data/work';
import { SITE_URL, SITE_DESCRIPTION } from '../data/site';

// Structured data: only what this page states (header, hero, footer, meta description).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': `${SITE_URL}/#organization`,
      name: 'Statecraft Systems',
      legalName: 'Statecraft Systems LLC',
      url: `${SITE_URL}/`,
      email: 'm@statecraft.systems',
      description: SITE_DESCRIPTION,
      image: `${SITE_URL}/og-default.png`,
      founder: {
        '@type': 'Person',
        '@id': `${SITE_URL}/#moritz-bierling`,
        name: 'Moritz Bierling',
        url: 'https://moritzbierling.com',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'Statecraft Systems',
      url: `${SITE_URL}/`,
      description: SITE_DESCRIPTION,
      inLanguage: 'en',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
  ],
};
---

<BaseLayout title="Statecraft Systems" jsonLd={jsonLd} tone="field">
  <section class="hero field">
    <div class="wrap">
      <h1 aria-label="The craft of good rule.">
        <span class="rise" style="--i:0" aria-hidden="true"><span>The craft</span></span>
        <span class="rise" style="--i:1" aria-hidden="true"><span>of good rule<span class="stop">.</span></span></span>
      </h1>
      <div class="hero-foot">
        <p class="lede">Every institution is ruled by something: one person’s memory, a vendor’s terms, or a structure built on purpose. We build the third kind. The working parts of small institutions, owned by the people who run them and made to keep working after we step back.</p>
        <div class="hero-actions">
          <a class="btn" href="mailto:m@statecraft.systems">Write to us</a>
          <a class="link-rule" href="/work">See the work</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-label="The name">
    <ul class="defs">
      <li class="reveal">
        <h2 class="w">State</h2>
        <p>The unit that must be governed. The condition a system is in. The state of affairs, which has to be seen clearly before any work begins.</p>
      </li>
      <li class="reveal">
        <h2 class="w">Craft</h2>
        <p>Direct contact with the material. Honest assessment, skilled making, the hand on the work.</p>
      </li>
      <li class="reveal">
        <h2 class="w">Systems</h2>
        <p>What remains after individuals leave. What compounds. What holds an obligation in place when nobody is watching.</p>
      </li>
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="props-h">
    <h2 class="statement reveal" id="props-h">Five things we hold to be true.</h2>
    <ol class="props">
      <li class="reveal"><span class="n" aria-hidden="true">I</span><h3>Good rule is scarce.</h3><p>The capacity for it does not arise by itself and does not maintain itself. It has to be cultivated in people and built into structures.</p></li>
      <li class="reveal"><span class="n" aria-hidden="true">II</span><h3>What is not built into a structure leaves with the person.</h3><p>A practice that lives in one head is a single point of failure. Written down and made to run, it becomes something others can carry.</p></li>
      <li class="reveal"><span class="n" aria-hidden="true">III</span><h3>Whoever holds the parts sets the terms.</h3><p>When the calendar, the inbox or the guest relationship belongs to someone else, so do the conditions you work under. Ownership is the practical form of sovereignty.</p></li>
      <li class="reveal"><span class="n" aria-hidden="true">IV</span><h3>A structure advances, or it oscillates.</h3><p>The result follows from the structure, not from the effort put into it. Change the structure and the same effort produces a different outcome.</p></li>
      <li class="reveal"><span class="n" aria-hidden="true">V</span><h3>The work is finished when it no longer needs us.</h3><p>A structure that depends on one person, ourselves included, has not been finished.</p></li>
    </ol>
    <div class="after"><a class="btn ghost" href="/thesis">Read the thesis</a></div>
  </section>

  <section class="section ground" aria-labelledby="fig-h">
    <div class="wrap">
      <div class="figure-head">
        <h2 class="statement" id="fig-h">Advance, <em>or oscillate.</em></h2>
        <p>Most effort oscillates. A problem presses, action follows, the pressure drops, the action stops. <strong>Held between an honest account of what is and a clear picture of what is wanted, the same effort moves one way.</strong> After Robert Fritz.</p>
      </div>
      <div class="tracks" role="img" aria-label="Two tracks. On the first, a marker swings back and forth between problem and relief. On the second, a marker moves steadily from what is to what is wanted.">
        <div class="track osc" aria-hidden="true">
          <div class="lane"><span class="tick a"></span><span class="tick b"></span><span class="mover"></span></div>
          <p class="caps"><span class="at-a">Problem</span><span class="at-b">Relief</span></p>
        </div>
        <div class="track adv" aria-hidden="true">
          <div class="lane"><span class="trail"></span><span class="tick a"></span><span class="tick b"></span><span class="mover"></span></div>
          <p class="caps"><span>What is</span><span>What is wanted</span></p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="scales-h">
    <h2 class="statement reveal" id="scales-h">One craft, two scales.</h2>
    <ul class="scales">
      <li class="reveal"><a href="mailto:m@statecraft.systems?subject=Working%20sessions">
        <span class="glyph" aria-hidden="true"><svg viewBox="0 0 100 100"><circle class="b" cx="50" cy="50" r="50" /></svg></span>
        <h3>Person</h3>
        <p>A founder, an executive, a team. We build real tools on your own devices and workflows, then teach you to extend them. The capability stays with you.</p>
        <span class="go">Write to us</span>
      </a></li>
      <li class="reveal"><a href="/work">
        <span class="glyph" aria-hidden="true"><svg viewBox="0 0 100 100"><rect class="b" width="100" height="100" /></svg></span>
        <h3>Institution</h3>
        <p>A clinic, a house, a supplier, a cause. We build its working parts: how a request arrives, how a date is held, who hears about it and when. Yours, written down, made to be handed on.</p>
        <span class="go">See the work</span>
      </a></li>
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="work-h">
    <h2 class="statement reveal" id="work-h">Small, and real.</h2>
    <ol class="index">
      {plates.map((plate) => (
        <li>
          <a href={`/work/${plate.slug}`}>
            <span class="title">{plate.principle}</span>
            <span class="who"><b>{plate.title}</b>{plate.client}</span>
            <span class="status">{plate.status}</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="after"><a class="btn ghost" href="/method">How a build runs</a></div>
  </section>

  <ContactBlock />
</BaseLayout>
