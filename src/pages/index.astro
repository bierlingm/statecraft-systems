---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { plates } from '../data/work';
import { SITE_URL, SITE_DESCRIPTION } from '../data/site';

// The home page is the offering: what can be asked for, the proof, how a build runs.
// The company (name, scales, thesis, disciplines, who) lives under /practice and gets
// one doorway here. Every fact in `offers` restates the method, terms or records page.
const offers: { glyph: 'square' | 'circle'; name: string; text: string; fact: string; go: string; href: string }[] = [
  { glyph: 'square', name: 'A build', href: '/work', go: 'See the work', fact: 'One to three weeks for a small site',
    text: 'A working part of your institution: intake, booking, enquiries, a single page with one ask. You review a working version on the real page, in rounds. At launch the domains, content, data and accounts are yours.' },
  { glyph: 'square', name: 'Care', href: '/terms', go: 'Read the terms', fact: 'Month to month',
    text: 'After launch we keep it online, secure and working, make the small changes, and reply within two business days. You hear from us only when something needs you. Either side can end it with 30 days’ notice.' },
  { glyph: 'circle', name: 'Working sessions', href: 'mailto:m@statecraft.systems?subject=Working%20sessions', go: 'Write to us', fact: 'By arrangement',
    text: 'For a founder, an executive or a team. We build real tools on your own devices and workflows, then teach you to extend them. The capability stays with you.' },
  { glyph: 'square', name: 'Records review', href: '/operating-records', go: 'Operating records', fact: 'Starts with 20 minutes',
    text: 'For companies with mature internal documentation. We help you decide whether to license your operating records for AI training: what qualifies, what must stay private, and whether the terms make sense.' },
];

// Structured data: only what this page states (header, hero, footer, meta description).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': `${SITE_URL}/#organization`,
      name: 'Statecraft Systems',
      legalName: 'Statecraft Systems LLC',
      url: `${SITE_URL}/`,
      email: 'm@statecraft.systems',
      description: SITE_DESCRIPTION,
      image: `${SITE_URL}/og-default.png`,
      founder: {
        '@type': 'Person',
        '@id': `${SITE_URL}/#moritz-bierling`,
        name: 'Moritz Bierling',
        url: 'https://moritzbierling.com',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'Statecraft Systems',
      url: `${SITE_URL}/`,
      description: SITE_DESCRIPTION,
      inLanguage: 'en',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
  ],
};
---

<BaseLayout title="Statecraft Systems" jsonLd={jsonLd} tone="field">
  <section class="hero field">
    <div class="wrap">
      <h1 aria-label="The working parts.">
        <span class="rise" style="--i:0" aria-hidden="true"><span>The working</span></span>
        <span class="rise" style="--i:1" aria-hidden="true"><span>parts<span class="stop">.</span></span></span>
      </h1>
      <div class="hero-foot">
        <p class="lede">We build the working parts of small institutions: intake for a clinic, booking for a house, enquiries for a supplier. Designed with the people who run the place, owned by them, and made to keep working after we step back.</p>
        <div class="hero-actions">
          <a class="btn" href="mailto:m@statecraft.systems">Write to us</a>
          <a class="link-rule" href="/work">See the work</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" id="offering" aria-labelledby="offer-h">
    <h2 class="statement reveal" id="offer-h">What you can ask for.</h2>
    <ul class="offers">
      {offers.map((o) => (
        <li><a href={o.href}>
          <span class="glyph" aria-hidden="true">
            <svg viewBox="0 0 100 100">{o.glyph === 'circle' ? <circle class="b" cx="50" cy="50" r="50" /> : <rect class="b" width="100" height="100" />}</svg>
          </span>
          <h3>{o.name}</h3>
          <p>{o.text}</p>
          <span class="fact">{o.fact}</span>
          <span class="go">{o.go}</span>
        </a></li>
      ))}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="work-h">
    <h2 class="statement reveal" id="work-h">Small, and real.</h2>
    <ol class="index">
      {plates.map((plate) => (
        <li>
          <a href={`/work/${plate.slug}`}>
            <span class="title">{plate.title}</span>
            <span class="who"><b>{plate.client}</b>{plate.principle}</span>
            <span class="status">{plate.status}</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="after"><a class="btn ghost" href="/work">All the work</a></div>
  </section>

  <section class="section ground" aria-labelledby="run-h">
    <div class="wrap">
      <h2 class="statement" id="run-h">How a build runs.</h2>
      <ol class="run">
        <li><h3>See</h3><p>One conversation with the person who does the work today.</p></li>
        <li><h3>Build</h3><p>A working version at a real address, in rounds. You leave notes on the page itself.</p></li>
        <li><h3>Launch</h3><p>Everything is written down so that someone else could carry it.</p></li>
        <li><h3>Run</h3><p>You take it over, or we keep it running and you hear only when something needs you.</p></li>
      </ol>
      <div class="after">
        <a class="btn ghost" href="/method">The method</a>
        <p class="run-note">A small site takes one to three weeks, end to end.</p>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="why-h">
    <h2 class="statement reveal" id="why-h">Who is behind it.</h2>
    <ul class="index">
      <li><a href="/practice">
        <span class="title">The practice</span>
        <span class="who wide">What the name means, the scales it works at, the thinking, and who does the work.</span>
      </a></li>
    </ul>
  </section>

  <ContactBlock />
</BaseLayout>
