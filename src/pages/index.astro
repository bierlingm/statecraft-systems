---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { plates } from '../data/work';
import { SITE_URL, SITE_DESCRIPTION } from '../data/site';

// The home page is the offering: what we do, recent work, how a build runs.
// The company (name, scales, thesis, disciplines, who) lives under /practice and gets
// one doorway here. Every fact in `offers` restates the method, terms or records page.
const offers: { glyph: 'square' | 'circle'; name: string; text: string; fact: string; go: string; href: string }[] = [
  { glyph: 'square', name: 'A build', href: '/work', go: 'See the work', fact: 'One to three weeks for a small site',
    text: 'A booking site, an intake form, an enquiry inbox or a single page. You get a working version early, comment on it directly, and we revise until it is right. You own the domain, the content, the data and the accounts.' },
  { glyph: 'square', name: 'Care', href: '/terms', go: 'Read the terms', fact: 'Month to month',
    text: 'A monthly plan for a site we built. We keep it online and secure, make small changes, and reply within two business days. Either side can cancel with 30 days’ notice.' },
  { glyph: 'circle', name: 'Working sessions', href: 'mailto:m@statecraft.systems?subject=Working%20sessions', go: 'Write to us', fact: 'By arrangement',
    text: 'For one person or a small team. We build tools for the work you already do, on your own computer, and show you how to change them yourself afterwards.' },
  { glyph: 'square', name: 'Records review', href: '/operating-records', go: 'Operating records', fact: 'First call: 20 minutes',
    text: 'For companies with years of internal documentation. Some AI labs pay to license records like these. We help you work out which of yours qualify and which have to stay private.' },
];

// Structured data: only what this page states (header, hero, footer, meta description).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': `${SITE_URL}/#organization`,
      name: 'Statecraft Systems',
      legalName: 'Statecraft Systems LLC',
      url: `${SITE_URL}/`,
      email: 'm@statecraft.systems',
      description: SITE_DESCRIPTION,
      image: `${SITE_URL}/og-default.png`,
      founder: {
        '@type': 'Person',
        '@id': `${SITE_URL}/#moritz-bierling`,
        name: 'Moritz Bierling',
        url: 'https://moritzbierling.com',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'Statecraft Systems',
      url: `${SITE_URL}/`,
      description: SITE_DESCRIPTION,
      inLanguage: 'en',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
  ],
};
---

<BaseLayout title="Statecraft Systems" jsonLd={jsonLd} tone="field">
  <section class="hero field">
    <div class="wrap">
      <h1 aria-label="The working parts.">
        <span class="rise" style="--i:0" aria-hidden="true"><span>The working</span></span>
        <span class="rise" style="--i:1" aria-hidden="true"><span>parts<span class="stop">.</span></span></span>
      </h1>
      <div class="hero-foot">
        <p class="lede">We build the working parts of small institutions, such as patient intake for a clinic or direct booking for a rental house. The people who run the place review every version, and they own the result.</p>
        <div class="hero-actions">
          <a class="btn" href="mailto:m@statecraft.systems">Write to us</a>
          <a class="link-rule" href="/work">See the work</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" id="offering" aria-labelledby="offer-h">
    <h2 class="statement reveal" id="offer-h">What we do.</h2>
    <ul class="offers">
      {offers.map((o) => (
        <li><a href={o.href}>
          <span class="glyph" aria-hidden="true">
            <svg viewBox="0 0 100 100">{o.glyph === 'circle' ? <circle class="b" cx="50" cy="50" r="50" /> : <rect class="b" width="100" height="100" />}</svg>
          </span>
          <h3>{o.name}</h3>
          <p>{o.text}</p>
          <span class="fact">{o.fact}</span>
          <span class="go">{o.go}</span>
        </a></li>
      ))}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="work-h">
    <h2 class="statement reveal" id="work-h">Recent work.</h2>
    <ol class="index">
      {plates.map((plate) => (
        <li>
          <a href={`/work/${plate.slug}`}>
            <span class="title">{plate.title}</span>
            <span class="who"><b>{plate.client}</b></span>
            <span class="status">{plate.status}</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="after"><a class="btn ghost" href="/work">All the work</a></div>
  </section>

  <section class="section ground" aria-labelledby="run-h">
    <div class="wrap">
      <h2 class="statement" id="run-h">How a build runs.</h2>
      <ol class="run">
        <li><h3>Talk</h3><p>We start with one conversation with the person who does the job now.</p></li>
        <li><h3>Build</h3><p>You get a working version at a private address and comment on the page. We revise and send the next one.</p></li>
        <li><h3>Launch</h3><p>The site goes live, and we write down how everything works.</p></li>
        <li><h3>Run</h3><p>You run it yourself, or we run it for you on a monthly plan.</p></li>
      </ol>
      <div class="after">
        <a class="btn ghost" href="/method">The method</a>
        <p class="run-note">A small site takes one to three weeks.</p>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="why-h">
    <h2 class="statement reveal" id="why-h">Who we are.</h2>
    <ul class="index">
      <li><a href="/practice">
        <span class="title">The practice</span>
        <span class="who wide">What the name means, the thesis behind the work, and who does it.</span>
      </a></li>
    </ul>
  </section>

  <ContactBlock />
</BaseLayout>
