---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlateCard from '../../components/PlateCard.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { plates } from '../../data/work';
---

<BaseLayout title="Work" description="Recent builds by Statecraft Systems: booking, clinical intake, trade enquiries and a nonprofit's single ask.">
  <section class="wrap page-head">
    <h1>Proof, at small scale.</h1>
    <p class="lede">Each one is a principle made to run: a working part of somebody’s practice, business or cause. Clients are described, not named.</p>
  </section>
  <section class="wrap plates" aria-label="Plates">
    {plates.map((plate) => <PlateCard plate={plate} />)}
  </section>
  <ContactBlock />
</BaseLayout>
