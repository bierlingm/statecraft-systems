---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlateCard from '../../components/PlateCard.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { plates } from '../../data/work';
---

<BaseLayout title="Work" description="Four recent builds by Statecraft Systems: direct booking, clinical intake, trade enquiries and a donation page for a nonprofit.">
  <section class="wrap page-head">
    <h1>Recent work.</h1>
    <p class="lede">Four recent builds. We describe each client without naming them.</p>
  </section>
  <section class="wrap plates" aria-label="Plates">
    {plates.map((plate) => <PlateCard plate={plate} />)}
  </section>
  <ContactBlock />
</BaseLayout>
