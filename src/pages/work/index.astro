---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlateCard from '../../components/PlateCard.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import { plates } from '../../data/work';

const [feature, ...rest] = plates;
---

<BaseLayout title="Work" description="Recent builds by Statecraft Systems: booking, clinical intake, trade enquiries and a nonprofit's single ask.">
  <section class="wrap page-head">
    <span class="eyebrow">Work</span>
    <h1>Plates from recent builds.</h1>
    <p class="lede">Each one is a working part of somebody’s practice, business or cause. Clients are described, not named; every line is something we can stand behind in conversation.</p>
    <QuickAnswer>
      <p>Four recent builds: direct booking for a family-owned vacation rental (launching), clinical intake for a cash-pay telemedicine practice (engineering pilot, shown on synthetic data only), trade enquiries for a regional jobsite-supply wholesaler (live since April 2026), and a one-page airline-miles donation ask for a child-recovery nonprofit (live).</p>
    </QuickAnswer>
  </section>
  <section class="wrap plates" aria-label="Plates">
    <PlateCard plate={feature} feature />
    <div class="plate-row">
      {rest.map((plate) => <PlateCard plate={plate} />)}
    </div>
  </section>
  <ContactBlock />
</BaseLayout>
