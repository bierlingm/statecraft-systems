---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tracks from '../components/Tracks.astro';
import ContactBlock from '../components/ContactBlock.astro';

// The ideas the work draws on, each credited to the person who worked it out.
// This page is about the ideas. What is sold is on the home, work and method pages.
// `says` restates the source; `take` is what Statecraft Systems does with it.
interface Discipline {
  id: string;
  name: string;
  by: string;
  source: string;
  href: string;
  claim: string;
  says: string[];
  take: string;
}

const disciplines: Discipline[] = [
  {
    id: 'structural-dynamics',
    name: 'Structural dynamics',
    by: 'Robert Fritz',
    source: 'The Path of Least Resistance, 1989',
    href: 'https://www.robertfritz.com',
    claim: 'The structure decides the outcome.',
    says: [
      'Fritz trained as a composer. He argues that energy follows the path of least resistance, and that the underlying structure sets where that path goes. If you change the structure, the same effort produces a different result.',
      'He describes two kinds of structure. In an oscillating one, a problem prompts action, the action eases the problem, and then the action stops, so the progress is undone. In an advancing one, action comes from structural tension, which is the gap between current reality and the result you want. That gap closes only when the result exists.',
    ],
    take: 'We start each build by writing down what happens now and what should happen, and we check every version against both.',
  },
  {
    id: 'natural-law',
    name: 'Natural law',
    by: 'Curt Doolittle',
    source: 'Natural Law Institute',
    href: 'https://naturallawinstitute.com',
    claim: 'Testable claims and reciprocal dealings.',
    says: [
      'Doolittle asks that claims be decidable. A claim should be stated as actions and their consequences, so that it can be tested. If it cannot be stated that way, there is nothing yet to decide on.',
      'For conduct, his test is reciprocity, which means you may not impose costs on others that they did not agree to. We use it to tell whether an arrangement is cooperation or extraction.',
    ],
    take: 'Our terms are short and written to be read. The client owns the domains, content, data and accounts, and can leave with them.',
  },
  {
    id: 'currency-design',
    name: 'Currency design',
    by: 'Arthur Brock',
    source: 'artbrock.com',
    href: 'https://www.artbrock.com',
    claim: 'A currency is a record of a flow.',
    says: [
      'Brock reads “currency” as “current-see”. He defines currencies as “formal symbol systems which shape, enable and measure currents”. Money is one kind. Olympic medals, race times and reputations are others.',
      'The flow itself passes, and the currency is the record of it. Whoever designs a currency chooses what gets recorded, how it is counted and who may issue it. Those choices change behaviour: millions of athletes train for the chance of a gold medal.',
    ],
    take: 'The shared booking calendar and the request inbox in our builds are small currencies in this sense. Each records something that used to be kept in one person’s head.',
  },
  {
    id: 'operative-traditions',
    name: 'Operative traditions',
    by: 'Miguel Angel Fernandez',
    source: 'Operative Traditions, 2017',
    href: 'https://manticore.press/product/operative-traditions/',
    claim: 'A tradition has to be practised.',
    says: [
      '“Operative” is a masons’ word. Operative masons built in stone, and the speculative lodges that came later treated building as a symbol. Fernandez writes about traditional craft and art in the first sense, and treats technique as something that forms the person who practises it.',
      'We take from this that a tradition lasts only while people practise it and know what it is for. Repeating the outward form does not keep it going.',
    ],
    take: 'At launch we write down how everything works, so that someone else could run it.',
  },
];
const [first, ...rest] = disciplines;
---

<BaseLayout title="Disciplines" description="The four bodies of work Statecraft Systems draws on: structural dynamics (Robert Fritz), natural law (Curt Doolittle), currency design (Arthur Brock) and operative traditions (Miguel Angel Fernandez).">
  <section class="wrap page-head">
    <h1>Four disciplines.</h1>
    <p class="lede">The practice draws on four bodies of work. Each is listed under its usual name, with the person who developed it and a link to the source.</p>
  </section>

  {[[first], rest].map((group, g) => (
    <>
      <section class="wrap disciplines" aria-label={g === 0 ? first.name : 'Further disciplines'}>
        {group.map((d) => (
          <article class="disc reveal" id={d.id}>
            <header>
              <h2>{d.name}</h2>
              <p class="by">{d.by}<a href={d.href} rel="noopener">{d.source}</a></p>
            </header>
            <div class="text">
              <p class="claim">{d.claim}</p>
              {d.says.map((p) => <p>{p}</p>)}
              <p class="use">{d.take}</p>
            </div>
          </article>
        ))}
      </section>
      {g === 0 && (
        <section class="section ground" aria-labelledby="fig-h">
          <div class="wrap">
            <div class="figure-head">
              <h2 class="statement" id="fig-h">Oscillate <em>or advance.</em></h2>
              <p>On the first line, a problem prompts action, the action eases the problem, and the action stops. <strong>On the second, the same effort is aimed at a wanted result and continues until it gets there.</strong></p>
            </div>
            <Tracks />
          </div>
        </section>
      )}
    </>
  ))}

  <section class="wrap after-list">
    <a class="btn ghost" href="/thesis">Read the thesis</a>
  </section>

  <ContactBlock />
</BaseLayout>
