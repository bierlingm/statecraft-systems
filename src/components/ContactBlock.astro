---
// The closing field. Sits directly above the footer.
interface Props {
  email?: string;
}
const { email = 'm@statecraft.systems' } = Astro.props;
---

<section class="closing field" aria-label="Write to us">
  <div class="wrap">
    <p class="big" aria-label="Begin with the state of affairs."><span aria-hidden="true">Begin with the</span> <span aria-hidden="true">state of affairs<span class="stop">.</span></span></p>
    <p class="sub">What happens now, what should happen, and who does the work today. A few sentences is enough. The reply comes from the person who would build it.</p>
    <a class="mail" href={`mailto:${email}`}>{email}</a>
  </div>
</section>
