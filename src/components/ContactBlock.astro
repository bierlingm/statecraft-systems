---
// The closing field. Sits directly above the footer.
interface Props {
  email?: string;
}
const { email = 'm@statecraft.systems' } = Astro.props;
---

<section class="closing field" aria-label="Write to us">
  <div class="wrap">
    <p class="big" aria-label="Write to us."><span aria-hidden="true">Write to us<span class="stop">.</span></span></p>
    <p class="sub">Tell us what happens now, what should happen instead, and who does the work today. A few sentences will do. Moritz Bierling replies.</p>
    <a class="mail" href={`mailto:${email}`}>{email}</a>
  </div>
</section>
