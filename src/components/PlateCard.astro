---
import Drawing from './Drawing.astro';
import type { Plate } from '../data/work';

interface Props {
  plate: Plate;
}
const { plate } = Astro.props;
---

<article class="plate reveal">
  <a href={`/work/${plate.slug}`}>
    <div class="plate-ground">
      <Drawing kind={plate.slug as any} label={plate.figure} />
    </div>
    <div class="caption">
      <div class="top">
        <h2>{plate.title}</h2>
        <span class="status">{plate.status}</span>
      </div>
      <p class="sum">{plate.summary}</p>
      <span class="more">See the build</span>
    </div>
  </a>
</article>
