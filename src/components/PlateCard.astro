---
import Drawing from './Drawing.astro';
import type { Plate } from '../data/work';

interface Props {
  plate: Plate;
  flip?: boolean;
}
const { plate, flip = false } = Astro.props;
const factKeys = ['Replaced', 'For', 'Built', 'Rounds', 'Parts'];
---

<article class:list={['plate', 'reveal', { flip }]}>
  <a href={`/work/${plate.slug}`}>
    <div class="plate-ground">
      <Drawing kind={plate.slug as any} label={`Drawing: ${plate.title.toLowerCase()}`} />
    </div>
    <div class="caption">
      <span class="eyebrow accent">Plate {plate.numeral} · {plate.status}</span>
      <h2>{plate.title}</h2>
      <p class="sum">{plate.summary}</p>
      <dl class="facts">
        {plate.facts.filter(([k]) => factKeys.includes(k)).map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
      <span class="more">Read the plate</span>
    </div>
  </a>
</article>
