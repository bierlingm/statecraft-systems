---
// Figures for the plates. One grammar, the same as the rest of the site:
// a circle is a person, a square is an institution or the thing that holds,
// a triangle is an instrument. White on the field; vermilion for what the
// build is for. No labels: the caption beside it does the naming.
interface Props {
  kind: 'direct-booking' | 'clinical-intake' | 'trade-enquiries' | 'one-page-one-ask';
  label: string;
}
const { kind, label } = Astro.props;
---

<svg class="drawing" role="img" aria-label={label} viewBox="0 0 640 400" fill="none">
  {kind === 'direct-booking' && (
    <>
      <rect x="40" y="76" width="48" height="48" />
      <rect x="40" y="176" width="48" height="48" />
      <circle class="fa" cx="64" cy="300" r="26" />
      <path d="M88 100H260M88 200H260" />
      <path class="a" d="M90 300H260" />
      <rect class="f" x="260" y="50" width="120" height="60" />
      <rect class="f" x="500" y="170" width="60" height="60" />
      <rect class="fa" x="380" y="290" width="120" height="60" />
      <path d="M320 50V350M380 50V350M440 50V350M500 50V350M260 110H560M260 170H560M260 230H560M260 290H560" />
      <rect x="260" y="50" width="300" height="300" />
    </>
  )}
  {kind === 'clinical-intake' && (
    <>
      <circle cx="92" cy="200" r="46" />
      <path d="M138 200H232" />
      <path d="M232 118L374 200L232 282Z" />
      <path class="a" d="M374 200H472" />
      <circle class="fa" cx="536" cy="200" r="64" />
    </>
  )}
  {kind === 'trade-enquiries' && (
    <>
      <circle cx="66" cy="88" r="26" />
      <circle cx="66" cy="200" r="26" />
      <circle cx="66" cy="312" r="26" />
      <path d="M92 88L300 200M92 200H300M92 312L300 200" />
      <rect class="fa" x="300" y="50" width="280" height="75" />
      <path d="M300 125H580M300 200H580M300 275H580" />
      <rect x="300" y="50" width="280" height="300" />
    </>
  )}
  {kind === 'one-page-one-ask' && (
    <>
      <rect x="170" y="50" width="300" height="300" />
      <circle class="fa" cx="320" cy="200" r="58" />
    </>
  )}
</svg>
