---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Path or absolute URL for the social preview image (1200×630). Defaults to /og-default.png */
  image?: string;
  /** Accessible alt text for the social preview image */
  imageAlt?: string;
  /** Set true for gated/admin pages that should not be shared or indexed */
  noindex?: boolean;
  footerEmail?: string;
  /** Structured data for this page. Must match what the page says. */
  jsonLd?: object;
  /** 'field' when the page opens on the blue field, 'ground' on the black: the header sits on it. */
  tone?: 'bone' | 'field' | 'ground';
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  footerEmail = 'm@statecraft.systems',
  jsonLd,
  tone = 'bone',
} = Astro.props;

const SITE = 'Statecraft Systems';
const DEFAULT_DESCRIPTION = 'Statecraft Systems builds the working parts of small institutions: intake, booking, enquiries and the systems behind them.';
const DEFAULT_IMAGE = '/og-default.png';
const DEFAULT_IMAGE_ALT = 'Statecraft Systems';
const SITE_URL = 'https://statecraft.systems';

const pageTitle = title === SITE ? SITE : `${title} — ${SITE}`;
const metaDescription = description || DEFAULT_DESCRIPTION;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image || DEFAULT_IMAGE, SITE_URL).href;
const ogImageAlt = imageAlt || DEFAULT_IMAGE_ALT;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Two halves. The offering: what can be asked for, the proof, how it runs.
// The practice: the company, its thesis and its disciplines.
const offering = [
  { href: '/work', label: 'Work' },
  { href: '/method', label: 'Method' },
];
const practice = { href: '/practice', label: 'Practice' };
const under = (href: string) => path === href || path.startsWith(href + '/');
const isCurrent = (href: string) => (under(href) ? 'page' : undefined);
const inPractice = ['/practice', '/thesis', '/disciplines'].some(under) ? 'page' : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={tone === 'field' ? '#1029c4' : tone === 'ground' ? '#09090d' : '#f1f0ea'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/archivo-latin-wdth-wght.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="alternate" type="application/feed+json" title="Statecraft Systems: public pages" href="/feed.json" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body class={`tone-${tone}`}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="mark" href="/" aria-label="Statecraft Systems, home">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><rect x="0.5" y="0.5" width="17" height="17" fill="none" stroke="currentColor"></rect><rect class="sq" x="5.5" y="5.5" width="7" height="7"></rect></svg>
          <span>Statecraft Systems</span>
        </a>
        <nav class="nav" aria-label="Main">
          {offering.map((item) => <a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a>)}
          <span class="sep" aria-hidden="true"></span>
          <a href={practice.href} aria-current={inPractice}>{practice.label}</a>
          <a class="btn sm ghost" href="mailto:m@statecraft.systems">Write to us</a>
        </nav>
        <details class="menu">
          <summary>Menu</summary>
          <ul>
            {offering.map((item) => <li><a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a></li>)}
            <li><a href={practice.href} aria-current={inPractice}>{practice.label}</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="mailto:m@statecraft.systems">Write to us</a></li>
          </ul>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <nav class="wrap foot" aria-label="Footer">
        <div>
          <a class="head" href="/#offering">Offering</a>
          <ul>
            <li><a href="/work">Work</a></li>
            <li><a href="/method">Method</a></li>
            <li><a href="/operating-records">Operating records</a></li>
          </ul>
        </div>
        <div>
          <a class="head" href="/practice">Practice</a>
          <ul>
            <li><a href="/thesis">Thesis</a></li>
            <li><a href="/disciplines">Disciplines</a></li>
          </ul>
        </div>
        <div>
          <a class="head" href="/contact">Contact</a>
          <ul>
            <li><a href={`mailto:${footerEmail}`}>{footerEmail}</a></li>
            <li><a href="/support">Support for clients</a></li>
          </ul>
        </div>
      </nav>
      <div class="wrap foot-base">
        <p>Statecraft Systems LLC, a US company. The practice of <a href="https://moritzbierling.com" rel="noopener">Moritz Bierling</a>.</p>
        <p><a href="/terms">Terms</a><a href="/privacy">Privacy</a></p>
      </div>
      <p class="wordmark" aria-hidden="true">Statecraft Systems</p>
    </footer>
  </body>
</html>
