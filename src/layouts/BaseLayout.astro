---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

const SITE = 'Statecraft Systems';
const DEFAULT_DESCRIPTION = 'Statecraft Systems builds the working parts of small institutions: intake, booking, enquiries and the systems behind them.';
const SITE_URL = 'https://statecraft.systems';

const pageTitle = title === SITE ? SITE : `${title} — ${SITE}`;
const metaDescription = description || DEFAULT_DESCRIPTION;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image || '/og-default.png', SITE_URL).href;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/method', label: 'Method' },
  { href: '/instruments', label: 'Instruments' },
  { href: '/thesis', label: 'Thesis' },
];
const isCurrent = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#f6f1e7" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/newsreader-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="mark" href="/" aria-label="Statecraft Systems, home">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="0.5" y="0.5" width="15" height="15" fill="none" stroke="currentColor"></rect><rect class="sq" x="5" y="5" width="6" height="6"></rect></svg>
          Statecraft Systems
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a>)}
          <a class="write" href="/contact" aria-current={isCurrent('/contact')}>Write to us</a>
        </nav>
        <details class="menu">
          <summary>Menu</summary>
          <ul>
            {nav.map((item) => <li><a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a></li>)}
            <li><a href="/contact">Write to us</a></li>
          </ul>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>Statecraft Systems LLC · Barcelona</span>
        <a href="mailto:contact@statecraft.systems">contact@statecraft.systems</a>
        <a href="https://moritzbierling.com" rel="noopener">moritzbierling.com</a>
        <span>Rev. 2026-09</span>
      </div>
    </footer>

    <!-- Spikes feedback widget · one project per site for unified inbox -->
    <script is:inline src="https://spikes.sh/widget.js" data-project="statecraft-systems" data-endpoint="https://spikes.sh/spikes" data-position="bottom-right" data-color="#7a2418"></script>
  </body>
</html>
