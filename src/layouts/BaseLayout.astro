---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  footerEmail?: string;
  /** Structured data for this page. Must match what the page says. */
  jsonLd?: object;
}

const { title, description, image, footerEmail = 'm@statecraft.systems', jsonLd } = Astro.props;

const SITE = 'Statecraft Systems';
import { SITE_DESCRIPTION as DEFAULT_DESCRIPTION } from '../data/site';
const SITE_URL = 'https://statecraft.systems';

const pageTitle = title === SITE ? SITE : `${title} — ${SITE}`;
const metaDescription = description || DEFAULT_DESCRIPTION;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image || '/og-default.png', SITE_URL).href;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/method', label: 'Method' },
  { href: '/instruments', label: 'Instruments' },
  { href: '/thesis', label: 'Thesis' },
];
const isCurrent = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#f6f1e7" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>(function(h){h.classList.add('js');setTimeout(function(){if(!document.querySelector('.assembly.mounted'))h.classList.add('failsafe')},2500)})(document.documentElement)</script>
    <link rel="preload" href="/fonts/newsreader-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/feed+json" title="Statecraft Systems: public pages" href="/feed.json" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="mark" href="/" aria-label="Statecraft Systems, home">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="0.5" y="0.5" width="15" height="15" fill="none" stroke="currentColor"></rect><rect class="sq" x="5" y="5" width="6" height="6"></rect></svg>
          Statecraft Systems
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a>)}
          <a class="write" href="/contact" aria-current={isCurrent('/contact')}>Write to us</a>
        </nav>
        <details class="menu">
          <summary>Menu</summary>
          <ul>
            {nav.map((item) => <li><a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a></li>)}
            <li><a href="/contact">Write to us</a></li>
          </ul>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cell"><span class="k">Statecraft Systems</span><span class="v">The working parts of small institutions.</span><span>Statecraft Systems LLC · A US company.</span></div>
        <div class="cell"><span class="k">Practitioner</span><a class="v" href="https://moritzbierling.com" rel="noopener">Moritz Bierling</a><a href={`mailto:${footerEmail}`}>{footerEmail}</a></div>
        <div class="cell"><span class="k">Sheets</span><a href="/work">Work</a><a href="/method">Method</a><a href="/instruments">Instruments</a><a href="/thesis">Thesis</a></div>
        <div class="cell"><span class="k">Records</span><a href="/operating-records">Operating records</a><a href="/support">Support</a><a href="/terms">Terms</a><a href="/privacy">Privacy</a><span>Rev. 2026-11</span></div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var ds = document.querySelectorAll('.drawing.ink');
        if (!ds.length) return;
        var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        ds.forEach(function (d) {
                    d.querySelectorAll('path, rect, circle, line').forEach(function (el) {
            if (el.getAttribute('stroke-dasharray') || el.matches('.shade, .shade-a, .dot-a, .heart')) return;
            el.setAttribute('pathLength', '1');
          });
        });
        if (still || !('IntersectionObserver' in window)) { ds.forEach(function (d) { d.classList.add('drawn'); }); return; }
        var draw = function (d) {
          d.classList.add('drawn');
          if (!d.animate) return;
          d.querySelectorAll('[pathLength]').forEach(function (el, i) {
            el.animate([{ strokeDasharray: '1', strokeDashoffset: 1 }, { strokeDasharray: '1', strokeDashoffset: 0 }], { duration: 1100, delay: i * 45, easing: 'cubic-bezier(.3,.1,.2,1)', fill: 'backwards' });
          });
          d.querySelectorAll('text, .shade, .shade-a, .dot-a, .heart').forEach(function (el) {
            el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 500, delay: 700, fill: 'backwards' });
          });
        };
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { draw(e.target); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -12% 0px' });
        ds.forEach(function (d) { io.observe(d); });
      })();
    </script>

  </body>
</html>
