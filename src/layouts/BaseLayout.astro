---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  footerEmail?: string;
  /** Structured data for this page. Must match what the page says. */
  jsonLd?: object;
  /** 'field' when the page opens on the blue field: the header sits on it. */
  tone?: 'bone' | 'field';
}

const { title, description, image, footerEmail = 'm@statecraft.systems', jsonLd, tone = 'bone' } = Astro.props;

const SITE = 'Statecraft Systems';
const DEFAULT_DESCRIPTION = 'Statecraft Systems builds the working parts of small institutions: intake, booking, enquiries and the systems behind them.';
const SITE_URL = 'https://statecraft.systems';

const pageTitle = title === SITE ? SITE : `${title} — ${SITE}`;
const metaDescription = description || DEFAULT_DESCRIPTION;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image || '/og-default.png', SITE_URL).href;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/method', label: 'Method' },
  { href: '/thesis', label: 'Thesis' },
];
const isCurrent = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content={tone === 'field' ? '#1029c4' : '#f1f0ea'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/archivo-latin-wdth-wght.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/feed+json" title="Statecraft Systems: public pages" href="/feed.json" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body class={`tone-${tone}`}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="mark" href="/" aria-label="Statecraft Systems, home">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><rect x="0.5" y="0.5" width="17" height="17" fill="none" stroke="currentColor"></rect><rect class="sq" x="5.5" y="5.5" width="7" height="7"></rect></svg>
          <span>Statecraft Systems</span>
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a>)}
          <a class="write" href="mailto:m@statecraft.systems">Write to us</a>
        </nav>
        <details class="menu">
          <summary>Menu</summary>
          <ul>
            {nav.map((item) => <li><a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a></li>)}
            <li><a href="/contact">Contact</a></li>
            <li><a href="mailto:m@statecraft.systems">Write to us</a></li>
          </ul>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-id">
          <p>Statecraft Systems LLC. A US company.</p>
          <p>The practice of <a href="https://moritzbierling.com" rel="noopener">Moritz Bierling</a>, working from Barcelona.</p>
        </div>
        <nav aria-label="Practice">
          <h2>Practice</h2>
          <ul>
            <li><a href="/work">Work</a></li>
            <li><a href="/method">Method</a></li>
            <li><a href="/thesis">Thesis</a></li>
            <li><a href="/instruments">Instruments</a></li>
            <li><a href="/operating-records">Operating records</a></li>
          </ul>
        </nav>
        <nav aria-label="Details">
          <h2>Details</h2>
          <ul>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/support">Support</a></li>
            <li><a href="/terms">Terms</a></li>
            <li><a href="/privacy">Privacy</a></li>
          </ul>
        </nav>
        <div>
          <h2>Write</h2>
          <ul>
            <li><a href={`mailto:${footerEmail}`}>{footerEmail}</a></li>
            <li><a href="https://moritzbierling.com" rel="noopener">moritzbierling.com</a></li>
          </ul>
        </div>
      </div>
      <p class="wordmark" aria-hidden="true">Statecraft Systems</p>
      <div class="wrap foot-base">
        <span>© 2026 Statecraft Systems LLC</span>
        <span>Rev. 2026-11</span>
      </div>
    </footer>
  </body>
</html>
